# Copiar como .env y completar los valores reales.
# ninguno de estos valores es secreto real: son solo defaults de desarrollo.

# --- Base de datos ---
# Por defecto (docker-compose): postgresql+psycopg2://postgres:postgres@db:5432/telecom_support
# Local sin Docker: postgresql+psycopg2://postgres:postgres@localhost:5432/telecom_support
# Con Supabase CLI (`supabase start`): usar la cadena que imprime el comando,
# normalmente postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/telecom_support

# --- JWT ---
JWT_SECRET=change-this-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- LLM del agente conversacional (Google Gemini) ---
# Sin esta key, el agente sigue funcionando con respuestas basadas en plantillas.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- App ---
ENV=development
DEBUG=true
